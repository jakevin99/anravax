# --- Required (production) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- API server ---
API_PORT=4000
PORT=3000
NODE_ENV=development

# --- Frontend (Vite; baked in at build time for production client) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- CORS (comma-separated origins; empty = allow all in dev) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT lifetimes (seconds) ---
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# --- Files ---
# FILES_DIR=server/data/uploads
# FILES_MAX_BYTES=10485760

# --- OCR (consultation PDF) ---
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_OCR_URL=https://api.mistral.ai/v1/ocr
# OCR_MAX_FILE_BYTES=26214400
# OCR_SPACE_API_KEY=
# OCR_SPACE_API_URL=
# OCR_SPACE_LANGUAGE=eng

# --- Feature flags ---
# FEATURE_PATIENT_AUTH=on
# FEATURE_PUSH_NOTIFICATIONS=off
# FEATURE_AUDIT_LOG=on

# --- Push (FCM) ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- SMS (patient OTP) ---
# SMS_PROVIDER=stub
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=ANIVAX
# OTP_REQUEST_LIMIT_PER_HOUR=5
# OTP_VERIFY_LIMIT_PER_HOUR=30
# DISABLE_OTP_RATE_LIMIT=0

# --- Maintenance ---
# PATIENT_RECYCLE_RETENTION_DAYS=30
# BACKUP_DIR=server/data/backups
# BACKUP_KEEP_DAYS=30
